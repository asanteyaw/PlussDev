\frametitle{Errors that point at your line}
\framesubtitle{Explicit failure over silent degradation -- a real traceback}
  \begin{columns}[T,onlytextwidth]
    \begin{column}{.62\textwidth}
\begin{lstlisting}[style=out,basicstyle=\ttfamily\fontsize{7.4}{9.2}\selectfont\color{pnavy}]
pluss::exception::Error: Traceback (most recent call last):
  File "program", in main
  File "program", in DataFramePlotAccessor::line(...)
  File "program", in ShelfPlotAccessor::line(...)
  File "program", in DataFrame::DataFrame(...)
  File "PlussMic/src/table/DataFrame.cpp", line 2495,
        in DataFrameImpl::validate_and_reindex_()
    PLUSS_CHECK(name_to_idx_.find(name) == name_to_idx_.end(),
                "DataFrame: duplicate column name 'user_id'")
\end{lstlisting}
    \end{column}
    \begin{column}{.38\textwidth}
      \begin{itemize}[<+->]
        \footnotesize
        \item Failures throw one error type with a \hb{stack trace}
        \item The message says what was wrong \emph{and} the value
        \item Build in \code{RelWithDebInfo} for file and line in downstream code
      \end{itemize}
    \end{column}
  \end{columns}
