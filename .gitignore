# Auto-aggregated docs mirror (regenerated by docs/scripts/aggregate_docs.py
# on every build -- never hand-edit, never commit)
**/_local/

# PlussBI dashboard CSS/JS/HTML embedded into a C++ header at CMake
# configure time from PlussTils/src/PlussBI/frontend/ (see that
# directory's CMakeLists.txt) -- never hand-edit, never commit.
PlussTils/include/pluss/bi/dashboard_assets.h

