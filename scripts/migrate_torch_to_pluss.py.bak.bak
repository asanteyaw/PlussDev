#!/usr/bin/env python3
import argparse
import os
import re

REPLACEMENTS = [
    # namespace and simple mappings
    (re.compile(r"\bnamespace\s+at\b"), "namespace pluss"),
    (re.compile(r"\bat::"), "pluss::"),
    (re.compile(r"\bATen\b"), "PlussQit"),
    (re.compile(r"\bc10::"), "MSharp::"),
    (re.compile(r"\btorch::Tensor\b"), "pluss::Series"),
]

EXCLUDE_DIRS = {"build", ".git", "data"}
FILE_EXTS = {".cpp", ".cc", ".cxx", ".c", ".h", ".hpp", ".hh", ".ipp", ".inl"}


def should_process(path):
    if any(part in EXCLUDE_DIRS for part in path.split(os.sep)):
        return False
    _, ext = os.path.splitext(path)
    return ext in FILE_EXTS


def process_file(path, dry_run=True, backup=True):
    with open(path, "r", encoding="utf-8", errors="replace") as f:
        orig = f.read()
    new = orig
    for pat, repl in REPLACEMENTS:
        new = pat.sub(repl, new)
    if new != orig:
        print("MODIFIED:" if not dry_run else "WILL MODIFY:", path)
        if not dry_run:
            if backup:
                bk = path + ".bak"
                with open(bk, "w", encoding="utf-8") as bf:
                    bf.write(orig)
            with open(path, "w", encoding="utf-8") as f:
                f.write(new)
        return True
    return False


def main():
    parser = argparse.ArgumentParser(description="Conservative textual codemod: torch/ATen/c10/at -> pluss/PlussQit/MSharp")
    parser.add_argument("root", nargs="?", default=".", help="Repo root")
    parser.add_argument("--apply", action="store_true", help="Apply changes (creates .bak files)")
    parser.add_argument("--dry-run", dest="dry_run", action="store_true", help="Show files that would change")
    args = parser.parse_args()

    changed = []
    for dirpath, dirnames, filenames in os.walk(args.root):
        # skip excluded dirs early
        parts = dirpath.split(os.sep)
        if any(p in EXCLUDE_DIRS for p in parts):
            continue
        for fn in filenames:
            full = os.path.join(dirpath, fn)
            if should_process(full):
                ok = process_file(full, dry_run=args.dry_run or not args.apply, backup=True)
                if ok:
                    changed.append(full)
    print(f"\nTotal files affected: {len(changed)}")

if __name__ == '__main__':
    main()
