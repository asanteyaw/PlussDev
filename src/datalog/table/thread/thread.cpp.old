#include <pluss/datalog/table/thread/thread.h>
#include <pluss/NoteOps.h>
#include <pluss/note_factory.h>
#include <pluss/series_factory.h>
#include <algorithm>
#include <unordered_map>
#include <unordered_set>

namespace pluss::table {

Thread Thread::head(int64_t n) const {
    if (n <= 0 || size() == 0) return Thread(pluss::zeros({0}), name_);
    const int64_t actual_n = std::min(n, size());
    
    if (is_series()) {
        auto s = as_series().narrow(0, 0, actual_n);
        return Thread(s, name_);
    }
    if (is_note()) {
        auto sliced = pluss::ops::slice(as_note(), 0, 0, static_cast<int>(actual_n));
        return Thread(sliced, name_);
    }
    if (is_timeline()) {
        // For Timeline, slice the underlying date/time series
        return *this;  // Simplified - full implementation would handle both date and time
    }
    return *this;
}

Thread Thread::tail(int64_t n) const {
    if (n <= 0 || size() == 0) return Thread(pluss::zeros({0}), name_);
    const int64_t sz = size();
    const int64_t actual_n = std::min(n, sz);
    const int64_t start = sz - actual_n;
    
    if (is_series()) {
        auto s = as_series().narrow(0, start, actual_n);
        return Thread(s, name_);
    }
    if (is_note()) {
        auto sliced = pluss::ops::slice(as_note(), 0, static_cast<int>(start), static_cast<int>(sz));
        return Thread(sliced, name_);
    }
    if (is_timeline()) {
        return *this;  // Placeholder
    }
    return *this;
}

Thread Thread::iloc(int64_t start, int64_t end) const {
    if (start < 0 || end <= start || size() == 0) return Thread(pluss::zeros({0}), name_);
    const int64_t sz = size();
    const int64_t actual_start = std::min(start, sz);
    const int64_t actual_end = std::min(end, sz);
    const int64_t length = actual_end - actual_start;
    
    if (is_series()) {
        auto s = as_series().narrow(0, actual_start, length);
        return Thread(s, name_);
    }
    if (is_note()) {
        auto sliced = pluss::ops::slice(as_note(), 0, static_cast<int>(actual_start), static_cast<int>(actual_end));
        return Thread(sliced, name_);
    }
    if (is_timeline()) {
        return *this;  // Placeholder
    }
    return *this;
}

Thread Thread::loc(const pluss::Series& condition) const {
    if (is_series()) {
        auto s = as_series();
        auto filtered = static_cast<const at::TensorBase&>(s).index({static_cast<const at::TensorBase&>(condition)});
        return Thread(pluss::from_torch(filtered), name_);
    }
    if (is_timeline()) {
        auto s = as_timeline().to_Series();
        auto filtered = static_cast<const at::TensorBase&>(s).index({static_cast<const at::TensorBase&>(condition)});
        return Thread(pluss::from_torch(filtered), name_);
    }
    if (is_note()) {
        // For Notes, filter using boolean mask
        try {
            auto vec = as_note().vector();
            std::vector<std::string> sel;
            auto mask = static_cast<const at::TensorBase&>(condition);
            for (int64_t i = 0; i < mask.size(0) && static_cast<size_t>(i) < vec.size(); ++i) {
                if (mask[i].item<int64_t>() != 0) sel.push_back(vec[i].str());
            }
            std::vector<pluss::Chord> chords;
            chords.reserve(sel.size());
            for (const auto &sstr : sel) chords.emplace_back(sstr);
            return Thread(pluss::make_note(chords), name_);
        } catch (...) {
            return *this;
        }
    }
    return *this;
}

Thread Thread::to(const torch::Device& device) const {
    if (is_series()) {
        auto t = static_cast<const at::TensorBase&>(as_series()).to(device);
        return Thread(pluss::from_torch(t), name_);
    }
    if (is_timeline()) {
        auto s = as_timeline().to_Series();
        auto t = static_cast<const at::TensorBase&>(s).to(device);
        return Thread(pluss::from_torch(t), name_);
    }
    // Notes unchanged
    return *this;
}

Thread Thread::unique() const {
    if (is_series()) {
        auto t = static_cast<const at::TensorBase&>(as_series());
        auto unique_vals = std::get<0>(torch::_unique(t));
        return Thread(pluss::from_torch(unique_vals), name_);
    }
    if (is_timeline()) {
        // Simplified - treat as Series
        auto s = as_timeline().to_Series();
        auto t = static_cast<const at::TensorBase&>(s);
        auto unique_vals = std::get<0>(torch::_unique(t));
        return Thread(pluss::from_torch(unique_vals), name_);
    }
    if (is_note()) {
        // For Notes, use vector-based unique
        try {
            auto vec = as_note().vector();
            std::vector<std::string> unique_strs;
            std::unordered_set<std::string> seen;
            for (const auto& chord : vec) {
                std::string s = chord.str();
                if (seen.insert(s).second) {
                    unique_strs.push_back(s);
                }
            }
            std::vector<pluss::Chord> chords;
            chords.reserve(unique_strs.size());
            for (const auto &s : unique_strs) chords.emplace_back(s);
            return Thread(pluss::make_note(chords), name_);
        } catch (...) {
            return *this;
        }
    }
    return *this;
}

Thread Thread::sort_values(bool ascending) const {
    if (is_series()) {
        auto t = static_cast<const at::TensorBase&>(as_series());
        auto sorted = std::get<0>(torch::sort(t, 0, ascending));
        return Thread(pluss::from_torch(sorted), name_);
    }
    if (is_timeline()) {
        auto s = as_timeline().to_Series();
        auto t = static_cast<const at::TensorBase&>(s);
        auto sorted = std::get<0>(torch::sort(t, 0, ascending));
        return Thread(pluss::from_torch(sorted), name_);
    }
    if (is_note()) {
        // Sort Notes by string value
        try {
            auto vec = as_note().vector();
            std::vector<std::string> strs;
            strs.reserve(vec.size());
            for (const auto& chord : vec) strs.push_back(chord.str());
            
            if (ascending) {
                std::sort(strs.begin(), strs.end());
            } else {
                std::sort(strs.begin(), strs.end(), std::greater<std::string>());
            }
            
            std::vector<pluss::Chord> chords;
            chords.reserve(strs.size());
            for (const auto &s : strs) chords.emplace_back(s);
            return Thread(pluss::make_note(chords), name_);
        } catch (...) {
            return *this;
        }
    }
    return *this;
}

Thread Thread::fillna(const Thread& value) const {
    if (is_series()) {
        auto t = static_cast<const at::TensorBase&>(as_series());
        auto filled = torch::nan_to_num(t, value.is_series() ? value.as_series().item<double>() : 0.0);
        return Thread(pluss::from_torch(filled), name_);
    }
    // Timelines and Notes typically don't have NaN
    return *this;
}

Thread Thread::dropna() const {
    if (is_series()) {
        auto t = static_cast<const at::TensorBase&>(as_series());
        auto mask = ~torch::isnan(t);
        auto filtered = t.index({mask});
        return Thread(pluss::from_torch(filtered), name_);
    }
    return *this;
}

pluss::Series Thread::isna() const {
    if (is_series()) {
        return pluss::from_torch(torch::isnan(static_cast<const at::TensorBase&>(as_series())));
    }
    // Timelines and Notes: return false mask
    return pluss::zeros({size()});
}

pluss::Series Thread::notna() const {
    if (is_series()) {
        return pluss::from_torch(~torch::isnan(static_cast<const at::TensorBase&>(as_series())));
    }
    // Timelines and Notes: return true mask
    return pluss::ones({size()});
}

Thread Thread::value_counts() const {
    if (is_series()) {
        auto t = static_cast<const at::TensorBase&>(as_series());
        // Simple implementation: unique + bincount
        auto unique_vals = std::get<0>(torch::_unique(t));
        return Thread(unique_vals, name_ + "_unique");
    }
    if (is_note()) {
        // Count occurrences of each unique string
        try {
            auto vec = as_note().vector();
            std::unordered_map<std::string, int64_t> counts;
            for (const auto& chord : vec) {
                counts[chord.str()]++;
            }
            std::vector<int64_t> count_vals;
            count_vals.reserve(counts.size());
            for (const auto& [_, count] : counts) {
                count_vals.push_back(count);
            }
            return Thread(pluss::from_torch(torch::tensor(count_vals)), name_ + "_counts");
        } catch (...) {
            return *this;
        }
    }
    return *this;
}

Thread Thread::rank(const std::string& method) const {
    if (is_series()) {
        auto t = static_cast<const at::TensorBase&>(as_series());
        auto sorted_indices = std::get<1>(torch::sort(t));
        auto ranks = torch::empty_like(t);
        ranks.index_put_({sorted_indices}, torch::arange(1, t.numel() + 1, t.options()));
        return Thread(pluss::from_torch(ranks), name_);
    }
    return *this;
}

Thread Thread::diff(int64_t periods) const {
    if (is_series()) {
        auto t = static_cast<const at::TensorBase&>(as_series());
        if (periods <= 0 || t.numel() <= periods) return Thread(pluss::from_torch(torch::full_like(t, NAN)), name_);
        
        auto shifted = torch::cat({torch::full({periods}, NAN, t.options()), t.slice(0, 0, t.numel() - periods)});
        auto result = t - shifted;
        return Thread(pluss::from_torch(result), name_);
    }
    return *this;
}

Thread Thread::shift(int64_t periods) const {
    if (is_series()) {
        auto t = static_cast<const at::TensorBase&>(as_series());
        if (periods == 0) return *this;
        
        if (periods > 0) {
            // Shift forward: prepend NaNs
            auto shifted = torch::cat({torch::full({periods}, NAN, t.options()), t.slice(0, 0, t.numel() - periods)});
            return Thread(pluss::from_torch(shifted), name_);
        } else {
            // Shift backward: append NaNs
            auto shifted = torch::cat({t.slice(0, -periods), torch::full({-periods}, NAN, t.options())});
            return Thread(pluss::from_torch(shifted), name_);
        }
    }
    return *this;
}

Thread Thread::cumsum() const {
    if (is_series()) {
        auto result = torch::cumsum(static_cast<const at::TensorBase&>(as_series()), 0);
        return Thread(pluss::from_torch(result), name_);
    }
    return *this;
}

Thread Thread::cumprod() const {
    if (is_series()) {
        auto result = torch::cumprod(static_cast<const at::TensorBase&>(as_series()), 0);
        return Thread(pluss::from_torch(result), name_);
    }
    return *this;
}

Thread Thread::cummax() const {
    if (is_series()) {
        auto result = std::get<0>(torch::cummax(static_cast<const at::TensorBase&>(as_series()), 0));
        return Thread(pluss::from_torch(result), name_);
    }
    return *this;
}

Thread Thread::cummin() const {
    if (is_series()) {
        auto result = std::get<0>(torch::cummin(static_cast<const at::TensorBase&>(as_series()), 0));
        return Thread(pluss::from_torch(result), name_);
    }
    return *this;
}

} // namespace pluss::table
