#include <pluss/datalog/handle/feed/feed.h>
#include <pluss/NoteOps.h>
#include <pluss/note_factory.h>
#include <pluss/series_factory.h>
#include <algorithm>
#include <cmath>
#include <sstream>
#include <stdexcept>
#include <cctype>
#include <numeric>

namespace pluss::handle {

// Professional, efficient, vectorized Feed operations following Thread-First patterns

// ========== Type Checking ==========

bool Feed::is_scalar() const noexcept {
    return std::holds_alternative<std::monostate>(value_) ||
           std::holds_alternative<bool>(value_) ||
           std::holds_alternative<int64_t>(value_) ||
           std::holds_alternative<double>(value_) ||
           std::holds_alternative<std::string>(value_) ||
           std::holds_alternative<pluss::Chord>(value_);
}

bool Feed::is_array() const noexcept {
    return std::holds_alternative<std::vector<int64_t>>(value_) ||
           std::holds_alternative<std::vector<double>>(value_) ||
           std::holds_alternative<std::vector<std::string>>(value_) ||
           std::holds_alternative<std::vector<bool>>(value_) ||
           std::holds_alternative<pluss::Series>(value_) ||
           std::holds_alternative<pluss::Note>(value_);
}

bool Feed::is_document() const noexcept {
    return std::holds_alternative<std::shared_ptr<DocumentValue>>(value_);
}

bool Feed::is_null() const noexcept {
    return std::holds_alternative<std::monostate>(value_);
}

bool Feed::is_bool() const noexcept {
    return std::holds_alternative<bool>(value_);
}

bool Feed::is_int() const noexcept {
    return std::holds_alternative<int64_t>(value_);
}

bool Feed::is_double() const noexcept {
    return std::holds_alternative<double>(value_);
}

bool Feed::is_string() const noexcept {
    return std::holds_alternative<std::string>(value_) ||
           std::holds_alternative<pluss::Chord>(value_);
}

bool Feed::is_series() const noexcept {
    return std::holds_alternative<pluss::Series>(value_);
}

bool Feed::is_note() const noexcept {
    return std::holds_alternative<pluss::Note>(value_);
}

// ========== Type Conversions ==========

// Note: With flat variant, we work directly with value_

int64_t Feed::as_int() const {
    if (std::holds_alternative<int64_t>(value_)) {
        return std::get<int64_t>(value_);
    }
    if (std::holds_alternative<double>(value_)) {
        return static_cast<int64_t>(std::get<double>(value_));
    }
    if (std::holds_alternative<bool>(value_)) {
        return std::get<bool>(value_) ? 1 : 0;
    }
    throw std::runtime_error("Cannot convert to int");
}

double Feed::as_double() const {
    if (std::holds_alternative<double>(value_)) {
        return std::get<double>(value_);
    }
    if (std::holds_alternative<int64_t>(value_)) {
        return static_cast<double>(std::get<int64_t>(value_));
    }
    if (std::holds_alternative<bool>(value_)) {
        return std::get<bool>(value_) ? 1.0 : 0.0;
    }
    throw std::runtime_error("Cannot convert to double");
}

std::string Feed::as_string() const {
    if (std::holds_alternative<std::string>(value_)) {
        return std::get<std::string>(value_);
    }
    if (std::holds_alternative<pluss::Chord>(value_)) {
        return std::get<pluss::Chord>(value_).str();
    }
    if (std::holds_alternative<int64_t>(value_)) {
        return std::to_string(std::get<int64_t>(value_));
    }
    if (std::holds_alternative<double>(value_)) {
        return std::to_string(std::get<double>(value_));
    }
    if (std::holds_alternative<bool>(value_)) {
        return std::get<bool>(value_) ? "true" : "false";
    }
    return "";
}

bool Feed::as_bool() const {
    if (std::holds_alternative<bool>(value_)) {
        return std::get<bool>(value_);
    }
    if (std::holds_alternative<int64_t>(value_)) {
        return std::get<int64_t>(value_) != 0;
    }
    if (std::holds_alternative<double>(value_)) {
        return std::get<double>(value_) != 0.0;
    }
    throw std::runtime_error("Cannot convert to bool");
}

pluss::Series& Feed::as_series() {
    if (!is_series()) {
        throw std::runtime_error("Feed is not a Series");
    }
    return std::get<pluss::Series>(value_);
}

const pluss::Series& Feed::as_series() const {
    if (!is_series()) {
        throw std::runtime_error("Feed is not a Series");
    }
    return std::get<pluss::Series>(value_);
}

pluss::Note& Feed::as_note() {
    if (!is_note()) {
        throw std::runtime_error("Feed is not a Note");
    }
    return std::get<pluss::Note>(value_);
}

const pluss::Note& Feed::as_note() const {
    if (!is_note()) {
        throw std::runtime_error("Feed is not a Note");
    }
    return std::get<pluss::Note>(value_);
}

Feed::DocumentValue& Feed::as_document() {
    if (!is_document()) {
        throw std::runtime_error("Feed is not a document");
    }
    return *std::get<std::shared_ptr<DocumentValue>>(value_);
}

const Feed::DocumentValue& Feed::as_document() const {
    if (!is_document()) {
        throw std::runtime_error("Feed is not a document");
    }
    return *std::get<std::shared_ptr<DocumentValue>>(value_);
}

// ========== Size/Shape ==========

int64_t Feed::size() const {
    if (is_scalar()) return 1;
    
    if (std::holds_alternative<pluss::Series>(value_)) {
        return std::get<pluss::Series>(value_).numel();
    }
    if (std::holds_alternative<pluss::Note>(value_)) {
        return std::get<pluss::Note>(value_).shape()[0];
    }
    if (std::holds_alternative<std::vector<int64_t>>(value_)) {
        return static_cast<int64_t>(std::get<std::vector<int64_t>>(value_).size());
    }
    if (std::holds_alternative<std::vector<double>>(value_)) {
        return static_cast<int64_t>(std::get<std::vector<double>>(value_).size());
    }
    if (std::holds_alternative<std::vector<std::string>>(value_)) {
        return static_cast<int64_t>(std::get<std::vector<std::string>>(value_).size());
    }
    if (std::holds_alternative<std::vector<bool>>(value_)) {
        return static_cast<int64_t>(std::get<std::vector<bool>>(value_).size());
    }
    
    if (is_document()) {
        return static_cast<int64_t>(as_document().size());
    }
    
    return 0;
}

bool Feed::empty() const {
    return size() == 0;
}

// ========== Helper Methods ==========

bool Feed::is_numeric() const {
    return is_int() || is_double();
}

double Feed::to_numeric() const {
    if (is_double()) return as_double();
    if (is_int()) return static_cast<double>(as_int());
    throw std::runtime_error("Feed is not numeric");
}

// ========== FEEDABLE OPERATIONS (MongoDB-style) ==========

Feed Feed::set(const Value& new_value) const {
    return Feed(new_value, name_);
}

Feed Feed::inc(double amount) const {
    if (!is_numeric()) {
        throw std::runtime_error("$inc requires numeric field");
    }
    double current = to_numeric();
    return Feed(current + amount, name_);
}

Feed Feed::mul(double factor) const {
    if (!is_numeric()) {
        throw std::runtime_error("$mul requires numeric field");
    }
    double current = to_numeric();
    return Feed(current * factor, name_);
}

Feed Feed::min(const Value& value) const {
    // $min: update if value is less than current
    if (!is_numeric()) return *this;
    
    double current_val = to_numeric();
    double new_val = current_val;
    
    if (std::holds_alternative<ScalarValue>(value)) {
        const auto& scalar = std::get<ScalarValue>(value);
        if (std::holds_alternative<double>(scalar)) {
            new_val = std::get<double>(scalar);
        } else if (std::holds_alternative<int64_t>(scalar)) {
            new_val = static_cast<double>(std::get<int64_t>(scalar));
        }
    }
    
    if (new_val < current_val) {
        return Feed(new_val, name_);
    }
    return *this;
}

Feed Feed::max(const Value& value) const {
    // $max: update if value is greater than current
    if (!is_numeric()) return *this;
    
    double current_val = to_numeric();
    double new_val = current_val;
    
    if (std::holds_alternative<ScalarValue>(value)) {
        const auto& scalar = std::get<ScalarValue>(value);
        if (std::holds_alternative<double>(scalar)) {
            new_val = std::get<double>(scalar);
        } else if (std::holds_alternative<int64_t>(scalar)) {
            new_val = static_cast<double>(std::get<int64_t>(scalar));
        }
    }
    
    if (new_val > current_val) {
        return Feed(new_val, name_);
    }
    return *this;
}

Feed Feed::rename(const std::string& new_name) const {
    Feed result = *this;
    result.set_name(new_name);
    return result;
}

// ========== Array Operations ==========

Feed Feed::push(const ScalarValue& value) const {
    if (!is_array()) {
        throw std::runtime_error("$push requires array field");
    }
    
    // Handle std::vector types directly from value_
    if (std::holds_alternative<std::vector<int64_t>>(value_)) {
        auto vec = std::get<std::vector<int64_t>>(value_);
        if (std::holds_alternative<int64_t>(value)) {
            vec.push_back(std::get<int64_t>(value));
        }
        return Feed(vec, name_);
    }
    
    if (std::holds_alternative<std::vector<double>>(value_)) {
        auto vec = std::get<std::vector<double>>(value_);
        if (std::holds_alternative<double>(value)) {
            vec.push_back(std::get<double>(value));
        } else if (std::holds_alternative<int64_t>(value)) {
            vec.push_back(static_cast<double>(std::get<int64_t>(value)));
        }
        return Feed(vec, name_);
    }
    
    if (std::holds_alternative<std::vector<std::string>>(value_)) {
        auto vec = std::get<std::vector<std::string>>(value_);
        if (std::holds_alternative<std::string>(value)) {
            vec.push_back(std::get<std::string>(value));
        }
        return Feed(vec, name_);
    }
    
    if (std::holds_alternative<std::vector<bool>>(value_)) {
        auto vec = std::get<std::vector<bool>>(value_);
        if (std::holds_alternative<bool>(value)) {
            vec.push_back(std::get<bool>(value));
        }
        return Feed(vec, name_);
    }
    
    // For Series, use concat (vectorized)
    if (is_series()) {
        const auto& s = as_series();
        double val_double = 0.0;
        if (std::holds_alternative<double>(value)) {
            val_double = std::get<double>(value);
        } else if (std::holds_alternative<int64_t>(value)) {
            val_double = static_cast<double>(std::get<int64_t>(value));
        }
        // Concat Series with single element
        auto new_elem = pluss::full({1}, val_double);
        auto result = pluss::from_torch(torch::cat({s.data(), new_elem.data()}, 0));
        return Feed(result, name_);
    }
    
    if (is_note()) {
        auto vec = as_note().vector();
        if (std::holds_alternative<std::string>(value)) {
            vec.emplace_back(std::get<std::string>(value));
        } else if (std::holds_alternative<pluss::Chord>(value)) {
            vec.push_back(std::get<pluss::Chord>(value));
        }
        return Feed(pluss::make_note(vec), name_);
    }
    
    return *this;
}

Feed Feed::push_each(const std::vector<ScalarValue>& values) const {
    Feed result = *this;
    for (const auto& val : values) {
        result = result.push(val);
    }
    return result;
}

Feed Feed::pop(int direction) const {
    if (!is_array()) {
        throw std::runtime_error("$pop requires array field");
    }
    
    const auto sz = size();
    if (sz == 0) return *this;
    
    if (is_series()) {
        const auto& s = as_series();
        if (direction < 0) {
            // Remove first element
            return Feed(s.narrow(0, 1, sz - 1), name_);
        } else {
            // Remove last element
            return Feed(s.narrow(0, 0, sz - 1), name_);
        }
    }
    
    if (is_note()) {
        auto vec = as_note().vector();
        if (direction < 0) {
            vec.erase(vec.begin());
        } else {
            vec.pop_back();
        }
        return Feed(pluss::make_note(vec), name_);
    }
    
    auto& arr = as_array();
    
    if (std::holds_alternative<std::vector<int64_t>>(arr)) {
        auto vec = std::get<std::vector<int64_t>>(arr);
        if (direction < 0) {
            vec.erase(vec.begin());
        } else {
            vec.pop_back();
        }
        return Feed(vec, name_);
    }
    
    if (std::holds_alternative<std::vector<double>>(arr)) {
        auto vec = std::get<std::vector<double>>(arr);
        if (direction < 0) {
            vec.erase(vec.begin());
        } else {
            vec.pop_back();
        }
        return Feed(vec, name_);
    }
    
    if (std::holds_alternative<std::vector<std::string>>(arr)) {
        auto vec = std::get<std::vector<std::string>>(arr);
        if (direction < 0) {
            vec.erase(vec.begin());
        } else {
            vec.pop_back();
        }
        return Feed(vec, name_);
    }
    
    if (std::holds_alternative<std::vector<bool>>(arr)) {
        auto vec = std::get<std::vector<bool>>(arr);
        if (direction < 0) {
            vec.erase(vec.begin());
        } else {
            vec.pop_back();
        }
        return Feed(vec, name_);
    }
    
    return *this;
}

Feed Feed::pull(const ScalarValue& value) const {
    if (!is_array()) {
        throw std::runtime_error("$pull requires array field");
    }
    
    if (is_series()) {
        const auto& s = as_series();
        double target = 0.0;
        if (std::holds_alternative<double>(value)) {
            target = std::get<double>(value);
        } else if (std::holds_alternative<int64_t>(value)) {
            target = static_cast<double>(std::get<int64_t>(value));
        }
        
        // Vectorized comparison: keep elements that don't match
        auto mask = s.ne(target);
        return Feed(s.masked_select(mask), name_);
    }
    
    if (is_note()) {
        auto vec = as_note().vector();
        std::string target;
        if (std::holds_alternative<std::string>(value)) {
            target = std::get<std::string>(value);
        } else if (std::holds_alternative<pluss::Chord>(value)) {
            target = std::get<pluss::Chord>(value).str();
        }
        
        std::vector<pluss::Chord> result;
        result.reserve(vec.size());
        for (const auto& chord : vec) {
            if (chord.str() != target) {
                result.push_back(chord);
            }
        }
        return Feed(pluss::make_note(result), name_);
    }
    
    auto& arr = as_array();
    
    if (std::holds_alternative<std::vector<int64_t>>(arr)) {
        auto vec = std::get<std::vector<int64_t>>(arr);
        if (std::holds_alternative<int64_t>(value)) {
            int64_t target = std::get<int64_t>(value);
            vec.erase(std::remove(vec.begin(), vec.end(), target), vec.end());
        }
        return Feed(vec, name_);
    }
    
    if (std::holds_alternative<std::vector<double>>(arr)) {
        auto vec = std::get<std::vector<double>>(arr);
        double target = 0.0;
        if (std::holds_alternative<double>(value)) {
            target = std::get<double>(value);
        } else if (std::holds_alternative<int64_t>(value)) {
            target = static_cast<double>(std::get<int64_t>(value));
        }
        vec.erase(std::remove(vec.begin(), vec.end(), target), vec.end());
        return Feed(vec, name_);
    }
    
    if (std::holds_alternative<std::vector<std::string>>(arr)) {
        auto vec = std::get<std::vector<std::string>>(arr);
        if (std::holds_alternative<std::string>(value)) {
            std::string target = std::get<std::string>(value);
            vec.erase(std::remove(vec.begin(), vec.end(), target), vec.end());
        }
        return Feed(vec, name_);
    }
    
    if (std::holds_alternative<std::vector<bool>>(arr)) {
        auto vec = std::get<std::vector<bool>>(arr);
        if (std::holds_alternative<bool>(value)) {
            bool target = std::get<bool>(value);
            vec.erase(std::remove(vec.begin(), vec.end(), target), vec.end());
        }
        return Feed(vec, name_);
    }
    
    return *this;
}

Feed Feed::add_to_set(const ScalarValue& value) const {
    if (!is_array()) {
        throw std::runtime_error("$addToSet requires array field");
    }
    
    // Check if value already exists
    if (is_series()) {
        const auto& s = as_series();
        double target = 0.0;
        if (std::holds_alternative<double>(value)) {
            target = std::get<double>(value);
        } else if (std::holds_alternative<int64_t>(value)) {
            target = static_cast<double>(std::get<int64_t>(value));
        }
        
        // Vectorized comparison
        auto mask = s.eq(target);
        bool exists = mask.any().item<bool>();
        
        if (!exists) {
            return push(value);
        }
        return *this;
    }
    
    if (is_note()) {
        auto vec = as_note().vector();
        std::string target;
        if (std::holds_alternative<std::string>(value)) {
            target = std::get<std::string>(value);
        } else if (std::holds_alternative<pluss::Chord>(value)) {
            target = std::get<pluss::Chord>(value).str();
        }
        
        bool exists = false;
        for (const auto& chord : vec) {
            if (chord.str() == target) {
                exists = true;
                break;
            }
        }
        
        if (!exists) {
            return push(value);
        }
        return *this;
    }
    
    auto& arr = as_array();
    
    if (std::holds_alternative<std::vector<int64_t>>(arr)) {
        auto vec = std::get<std::vector<int64_t>>(arr);
        if (std::holds_alternative<int64_t>(value)) {
            int64_t target = std::get<int64_t>(value);
            if (std::find(vec.begin(), vec.end(), target) == vec.end()) {
                return push(value);
            }
        }
        return *this;
    }
    
    if (std::holds_alternative<std::vector<double>>(arr)) {
        auto vec = std::get<std::vector<double>>(arr);
        double target = 0.0;
        if (std::holds_alternative<double>(value)) {
            target = std::get<double>(value);
        } else if (std::holds_alternative<int64_t>(value)) {
            target = static_cast<double>(std::get<int64_t>(value));
        }
        if (std::find(vec.begin(), vec.end(), target) == vec.end()) {
            return push(value);
        }
        return *this;
    }
    
    if (std::holds_alternative<std::vector<std::string>>(arr)) {
        auto vec = std::get<std::vector<std::string>>(arr);
        if (std::holds_alternative<std::string>(value)) {
            std::string target = std::get<std::string>(value);
            if (std::find(vec.begin(), vec.end(), target) == vec.end()) {
                return push(value);
            }
        }
        return *this;
    }
    
    if (std::holds_alternative<std::vector<bool>>(arr)) {
        auto vec = std::get<std::vector<bool>>(arr);
        if (std::holds_alternative<bool>(value)) {
            bool target = std::get<bool>(value);
            if (std::find(vec.begin(), vec.end(), target) == vec.end()) {
                return push(value);
            }
        }
        return *this;
    }
    
    return *this;
}

Feed Feed::slice(int64_t start, int64_t end) const {
    if (!is_array()) {
        throw std::runtime_error("slice requires array field");
    }
    
    const auto sz = size();
    if (start < 0) start = 0;
    if (end > sz) end = sz;
    if (start >= end) {
        // Return empty array
        if (is_series()) {
            return Feed(pluss::zeros({0}), name_);
        }
        if (is_note()) {
            return Feed(pluss::make_note(), name_);
        }
    }
    
    const int64_t length = end - start;
    
    if (is_series()) {
        return Feed(as_series().narrow(0, start, length), name_);
    }
    
    if (is_note()) {
        return Feed(pluss::ops::slice(as_note(), 0, static_cast<int>(start), static_cast<int>(end)), name_);
    }
    
    auto& arr = as_array();
    
    if (std::holds_alternative<std::vector<int64_t>>(arr)) {
        auto vec = std::get<std::vector<int64_t>>(arr);
        std::vector<int64_t> result(vec.begin() + start, vec.begin() + end);
        return Feed(result, name_);
    }
    
    if (std::holds_alternative<std::vector<double>>(arr)) {
        auto vec = std::get<std::vector<double>>(arr);
        std::vector<double> result(vec.begin() + start, vec.begin() + end);
        return Feed(result, name_);
    }
    
    if (std::holds_alternative<std::vector<std::string>>(arr)) {
        auto vec = std::get<std::vector<std::string>>(arr);
        std::vector<std::string> result(vec.begin() + start, vec.begin() + end);
        return Feed(result, name_);
    }
    
    if (std::holds_alternative<std::vector<bool>>(arr)) {
        auto vec = std::get<std::vector<bool>>(arr);
        std::vector<bool> result(vec.begin() + start, vec.begin() + end);
        return Feed(result, name_);
    }
    
    return *this;
}

Feed Feed::at(int64_t index) const {
    if (!is_array()) {
        throw std::runtime_error("at requires array field");
    }
    
    const auto sz = size();
    if (index < 0 || index >= sz) {
        throw std::out_of_range("Index out of range");
    }
    
    if (is_series()) {
        double val = as_series()[index].item<double>();
        return Feed(val, name_);
    }
    
    if (is_note()) {
        auto vec = as_note().vector();
        return Feed(vec[index], name_);
    }
    
    if (std::holds_alternative<std::vector<int64_t>>(value_)) {
        return Feed(std::get<std::vector<int64_t>>(value_)[index], name_);
    }
    
    if (std::holds_alternative<std::vector<double>>(value_)) {
        return Feed(std::get<std::vector<double>>(value_)[index], name_);
    }
    
    if (std::holds_alternative<std::vector<std::string>>(value_)) {
        return Feed(std::get<std::vector<std::string>>(value_)[index], name_);
    }
    
    if (std::holds_alternative<std::vector<bool>>(value_)) {
        bool val = std::get<std::vector<bool>>(value_)[index];  // explicit conversion from proxy
        return Feed(val, name_);
    }
    
    return *this;
}

// ========== Document Operations ==========

Feed Feed::get_field(const std::string& field) const {
    if (!is_document()) {
        throw std::runtime_error("get_field requires document");
    }
    
    const auto& doc = as_document();
    auto it = doc.find(field);
    if (it != doc.end()) {
        return *it->second;
    }
    
    return Feed();  // Return null Feed
}

Feed Feed::set_field(const std::string& field, const Feed& value) const {
    if (!is_document()) {
        throw std::runtime_error("set_field requires document");
    }
    
    auto doc = as_document();
    doc[field] = std::make_shared<Feed>(value);
    return Feed(doc, name_);
}

Feed Feed::unset_field(const std::string& field) const {
    if (!is_document()) {
        throw std::runtime_error("unset_field requires document");
    }
    
    auto doc = as_document();
    doc.erase(field);
    return Feed(doc, name_);
}

bool Feed::has_field(const std::string& field) const {
    if (!is_document()) return false;
    const auto& doc = as_document();
    return doc.find(field) != doc.end();
}

std::vector<std::string> Feed::fields() const {
    if (!is_document()) {
        return {};
    }
    
    const auto& doc = as_document();
    std::vector<std::string> result;
    result.reserve(doc.size());
    for (const auto& [key, _] : doc) {
        result.push_back(key);
    }
    return result;
}

// ========== Comparison Operations ==========

bool Feed::eq(const Feed& other) const {
    if (is_scalar() && other.is_scalar()) {
        if (is_int() && other.is_int()) {
            return as_int() == other.as_int();
        }
        if (is_numeric() && other.is_numeric()) {
            return to_numeric() == other.to_numeric();
        }
        if (is_string() && other.is_string()) {
            return as_string() == other.as_string();
        }
        if (is_bool() && other.is_bool()) {
            return as_bool() == other.as_bool();
        }
    }
    return false;
}

bool Feed::ne(const Feed& other) const {
    return !eq(other);
}

bool Feed::lt(const Feed& other) const {
    if (is_numeric() && other.is_numeric()) {
        return to_numeric() < other.to_numeric();
    }
    if (is_string() && other.is_string()) {
        return as_string() < other.as_string();
    }
    return false;
}

bool Feed::le(const Feed& other) const {
    if (is_numeric() && other.is_numeric()) {
        return to_numeric() <= other.to_numeric();
    }
    if (is_string() && other.is_string()) {
        return as_string() <= other.as_string();
    }
    return false;
}

bool Feed::gt(const Feed& other) const {
    if (is_numeric() && other.is_numeric()) {
        return to_numeric() > other.to_numeric();
    }
    if (is_string() && other.is_string()) {
        return as_string() > other.as_string();
    }
    return false;
}

bool Feed::ge(const Feed& other) const {
    if (is_numeric() && other.is_numeric()) {
        return to_numeric() >= other.to_numeric();
    }
    if (is_string() && other.is_string()) {
        return as_string() >= other.as_string();
    }
    return false;
}

bool Feed::in(const std::vector<ScalarValue>& values) const {
    if (!is_scalar()) return false;
    
    for (const auto& val : values) {
        if (is_int() && std::holds_alternative<int64_t>(val)) {
            if (as_int() == std::get<int64_t>(val)) return true;
        }
        if (is_double() && std::holds_alternative<double>(val)) {
            if (as_double() == std::get<double>(val)) return true;
        }
        if (is_string() && std::holds_alternative<std::string>(val)) {
            if (as_string() == std::get<std::string>(val)) return true;
        }
        if (is_bool() && std::holds_alternative<bool>(val)) {
            if (as_bool() == std::get<bool>(val)) return true;
        }
    }
    return false;
}

bool Feed::nin(const std::vector<ScalarValue>& values) const {
    return !in(values);
}

// ========== Logical Operations ==========

bool Feed::exists() const {
    return !is_null();
}

std::string Feed::type() const {
    if (is_null()) return "null";
    if (is_bool()) return "bool";
    if (is_int()) return "int";
    if (is_double()) return "double";
    if (is_string()) return "string";
    if (is_series()) return "series";
    if (is_note()) return "note";
    if (is_document()) return "document";
    
    if (is_array()) {
        const auto& arr = as_array();
        if (std::holds_alternative<std::vector<int64_t>>(arr)) return "array<int>";
        if (std::holds_alternative<std::vector<double>>(arr)) return "array<double>";
        if (std::holds_alternative<std::vector<std::string>>(arr)) return "array<string>";
        if (std::holds_alternative<std::vector<bool>>(arr)) return "array<bool>";
    }
    
    return "unknown";
}

// ========== String Operations ==========

Feed Feed::to_upper() const {
    if (!is_string()) {
        throw std::runtime_error("to_upper requires string field");
    }
    
    std::string str = as_string();
    std::transform(str.begin(), str.end(), str.begin(), 
                   [](unsigned char c) { return std::toupper(c); });
    return Feed(str, name_);
}

Feed Feed::to_lower() const {
    if (!is_string()) {
        throw std::runtime_error("to_lower requires string field");
    }
    
    std::string str = as_string();
    std::transform(str.begin(), str.end(), str.begin(), 
                   [](unsigned char c) { return std::tolower(c); });
    return Feed(str, name_);
}

Feed Feed::trim() const {
    if (!is_string()) {
        throw std::runtime_error("trim requires string field");
    }
    
    std::string str = as_string();
    // Trim leading whitespace
    str.erase(str.begin(), std::find_if(str.begin(), str.end(), 
              [](unsigned char ch) { return !std::isspace(ch); }));
    // Trim trailing whitespace
    str.erase(std::find_if(str.rbegin(), str.rend(), 
              [](unsigned char ch) { return !std::isspace(ch); }).base(), str.end());
    return Feed(str, name_);
}

Feed Feed::concat(const std::string& suffix) const {
    if (!is_string()) {
        throw std::runtime_error("concat requires string field");
    }
    
    return Feed(as_string() + suffix, name_);
}

bool Feed::contains(const std::string& substring) const {
    if (!is_string()) return false;
    return as_string().find(substring) != std::string::npos;
}

bool Feed::starts_with(const std::string& prefix) const {
    if (!is_string()) return false;
    const std::string str = as_string();
    return str.size() >= prefix.size() && 
           str.compare(0, prefix.size(), prefix) == 0;
}

bool Feed::ends_with(const std::string& suffix) const {
    if (!is_string()) return false;
    const std::string str = as_string();
    return str.size() >= suffix.size() && 
           str.compare(str.size() - suffix.size(), suffix.size(), suffix) == 0;
}

// ========== Numeric Operations ==========

Feed Feed::abs() const {
    if (!is_numeric()) {
        throw std::runtime_error("abs requires numeric field");
    }
    return Feed(std::abs(to_numeric()), name_);
}

Feed Feed::round(int decimals) const {
    if (!is_numeric()) {
        throw std::runtime_error("round requires numeric field");
    }
    
    double val = to_numeric();
    double scale = std::pow(10.0, decimals);
    return Feed(std::round(val * scale) / scale, name_);
}

Feed Feed::floor() const {
    if (!is_numeric()) {
        throw std::runtime_error("floor requires numeric field");
    }
    return Feed(std::floor(to_numeric()), name_);
}

Feed Feed::ceil() const {
    if (!is_numeric()) {
        throw std::runtime_error("ceil requires numeric field");
    }
    return Feed(std::ceil(to_numeric()), name_);
}

Feed Feed::sqrt() const {
    if (!is_numeric()) {
        throw std::runtime_error("sqrt requires numeric field");
    }
    return Feed(std::sqrt(to_numeric()), name_);
}

Feed Feed::pow(double exponent) const {
    if (!is_numeric()) {
        throw std::runtime_error("pow requires numeric field");
    }
    return Feed(std::pow(to_numeric(), exponent), name_);
}

// ========== Array Aggregations ==========

double Feed::sum() const {
    if (is_series()) {
        return as_series().sum().item<double>();
    }
    
    if (is_array()) {
        const auto& arr = as_array();
        
        if (std::holds_alternative<std::vector<int64_t>>(arr)) {
            const auto& vec = std::get<std::vector<int64_t>>(arr);
            return static_cast<double>(std::accumulate(vec.begin(), vec.end(), 0LL));
        }
        
        if (std::holds_alternative<std::vector<double>>(arr)) {
            const auto& vec = std::get<std::vector<double>>(arr);
            return std::accumulate(vec.begin(), vec.end(), 0.0);
        }
    }
    
    if (is_numeric()) {
        return to_numeric();
    }
    
    return 0.0;
}

double Feed::mean() const {
    if (is_series()) {
        return as_series().mean().item<double>();
    }
    
    const auto sz = size();
    if (sz == 0) return 0.0;
    
    return sum() / static_cast<double>(sz);
}

double Feed::min_value() const {
    if (is_series()) {
        return as_series().min().item<double>();
    }
    
    if (is_array()) {
        const auto& arr = as_array();
        
        if (std::holds_alternative<std::vector<int64_t>>(arr)) {
            const auto& vec = std::get<std::vector<int64_t>>(arr);
            if (vec.empty()) return std::numeric_limits<double>::quiet_NaN();
            return static_cast<double>(*std::min_element(vec.begin(), vec.end()));
        }
        
        if (std::holds_alternative<std::vector<double>>(arr)) {
            const auto& vec = std::get<std::vector<double>>(arr);
            if (vec.empty()) return std::numeric_limits<double>::quiet_NaN();
            return *std::min_element(vec.begin(), vec.end());
        }
    }
    
    if (is_numeric()) {
        return to_numeric();
    }
    
    return std::numeric_limits<double>::quiet_NaN();
}

double Feed::max_value() const {
    if (is_series()) {
        return as_series().max().item<double>();
    }
    
    if (is_array()) {
        const auto& arr = as_array();
        
        if (std::holds_alternative<std::vector<int64_t>>(arr)) {
            const auto& vec = std::get<std::vector<int64_t>>(arr);
            if (vec.empty()) return std::numeric_limits<double>::quiet_NaN();
            return static_cast<double>(*std::max_element(vec.begin(), vec.end()));
        }
        
        if (std::holds_alternative<std::vector<double>>(arr)) {
            const auto& vec = std::get<std::vector<double>>(arr);
            if (vec.empty()) return std::numeric_limits<double>::quiet_NaN();
            return *std::max_element(vec.begin(), vec.end());
        }
    }
    
    if (is_numeric()) {
        return to_numeric();
    }
    
    return std::numeric_limits<double>::quiet_NaN();
}

int64_t Feed::count() const {
    if (is_series()) {
        // Count non-NaN values
        const auto& s = as_series();
        return (s.data() == s.data()).sum().item<int64_t>();  // NaN != NaN
    }
    
    return size();
}

// ========== Serialization ==========

std::string Feed::to_json() const {
    std::ostringstream oss;
    
    if (is_null()) {
        oss << "null";
    } else if (is_bool()) {
        oss << (as_bool() ? "true" : "false");
    } else if (is_int()) {
        oss << as_int();
    } else if (is_double()) {
        oss << as_double();
    } else if (is_string()) {
        oss << "\"" << as_string() << "\"";
    } else if (is_array()) {
        oss << "[";
        const auto sz = size();
        
        if (is_series()) {
            const auto& s = as_series();
            // Use item<T>() for individual element access
            for (int64_t i = 0; i < sz; ++i) {
                if (i > 0) oss << ",";
                oss << s[i].item<double>();
            }
        } else if (is_note()) {
            auto vec = as_note().vector();
            for (size_t i = 0; i < vec.size(); ++i) {
                if (i > 0) oss << ",";
                oss << "\"" << vec[i].str() << "\"";
            }
        } else {
            const auto& arr = as_array();
            
            if (std::holds_alternative<std::vector<int64_t>>(arr)) {
                const auto& vec = std::get<std::vector<int64_t>>(arr);
                for (size_t i = 0; i < vec.size(); ++i) {
                    if (i > 0) oss << ",";
                    oss << vec[i];
                }
            } else if (std::holds_alternative<std::vector<double>>(arr)) {
                const auto& vec = std::get<std::vector<double>>(arr);
                for (size_t i = 0; i < vec.size(); ++i) {
                    if (i > 0) oss << ",";
                    oss << vec[i];
                }
            } else if (std::holds_alternative<std::vector<std::string>>(arr)) {
                const auto& vec = std::get<std::vector<std::string>>(arr);
                for (size_t i = 0; i < vec.size(); ++i) {
                    if (i > 0) oss << ",";
                    oss << "\"" << vec[i] << "\"";
                }
            } else if (std::holds_alternative<std::vector<bool>>(arr)) {
                const auto& vec = std::get<std::vector<bool>>(arr);
                for (size_t i = 0; i < vec.size(); ++i) {
                    if (i > 0) oss << ",";
                    oss << (vec[i] ? "true" : "false");
                }
            }
        }
        
        oss << "]";
    } else if (is_document()) {
        oss << "{";
        const auto& doc = as_document();
        bool first = true;
        for (const auto& [key, value] : doc) {
            if (!first) oss << ",";
            first = false;
            oss << "\"" << key << "\":" << value->to_json();
        }
        oss << "}";
    }
    
    return oss.str();
}

std::string Feed::to_bson() const {
    // Simplified BSON-like representation
    // In production, use a proper BSON library
    return to_json();
}

std::string Feed::to_string() const {
    if (is_string()) {
        return as_string();
    }
    return to_json();
}

Feed Feed::from_json(const std::string& json, const std::string& name) {
    // Simplified JSON parser for basic types
    // In production, use a proper JSON library like nlohmann::json
    
    std::string trimmed = json;
    trimmed.erase(0, trimmed.find_first_not_of(" \t\n\r"));
    trimmed.erase(trimmed.find_last_not_of(" \t\n\r") + 1);
    
    if (trimmed == "null") {
        Feed result;
        result.set_name(name);
        return result;
    }
    
    if (trimmed == "true") {
        return Feed(true, name);
    }
    
    if (trimmed == "false") {
        return Feed(false, name);
    }
    
    if (!trimmed.empty() && trimmed[0] == '"') {
        // String value
        if (trimmed.size() >= 2 && trimmed.back() == '"') {
            return Feed(trimmed.substr(1, trimmed.size() - 2), name);
        }
    }
    
    // Try parsing as number
    try {
        if (trimmed.find('.') != std::string::npos) {
            return Feed(std::stod(trimmed), name);
        } else {
            return Feed(std::stoll(trimmed), name);
        }
    } catch (...) {
        // Not a number
    }
    
    Feed result;
    result.set_name(name);
    return result;
}

Feed Feed::from_bson(const std::string& bson, const std::string& name) {
    // Simplified BSON parser
    // In production, use a proper BSON library
    return from_json(bson, name);
}

