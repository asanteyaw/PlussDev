# target to preprocess a source file
rnn_fusion_test.cpp.i:
	cd /Users/yawasante/software/cxx/PlussDev/build_cpp_env && $(MAKE) $(MAKESILENT) -f PlussAI/test/CMakeFiles/rnn_fusion_test.dir/build.make PlussAI/test/CMakeFiles/rnn_fusion_test.dir/rnn_fusion_test.cpp.i
.PHONY : rnn_fusion_test.cpp.i

rnn_fusion_test.s: rnn_fusion_test.cpp.s
.PHONY : rnn_fusion_test.s

