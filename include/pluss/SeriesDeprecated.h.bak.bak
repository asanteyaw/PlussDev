  Series to_padded_tensor_symint(double padding, OptionalSymIntArrayRef output_size=::std::nullopt) const;

  // Special C++ only overloads for std()-like functions (See gh-40287)
  // These are needed because int -> bool conversion takes precedence over int -> IntArrayRef
  // So, for example std(0) would select the std(unbiased=False) overload

  Series var(int64_t dim) const {
    return var(IntArrayRef{dim});
  }
  
  Series std(int64_t dim) const {
    return std(IntArrayRef{dim});
  }

  // Item method
  template <typename T>
  T item() const;

  int64_t shape(int64_t dim) const {
    return sizes()[dim];
  }

  IntArrayRef shape() const {
    return sizes();  // Assuming Series::sizes() is already defined
  }

  // Scalar item() const {
  //   return at::Tensor(*this).item();
  // }

  // String representation
  std::string toString() const {
    return at::Tensor(*this).toString();
  }

};
