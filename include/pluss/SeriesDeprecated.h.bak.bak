inline ::std::vector<Series> Series::nonzero_numpy() const {
  auto ts = at::_ops::nonzero_numpy::call(const_cast<at::Tensor&>(static_cast<const at::Tensor&>(*this)));
  std::vector<Series> out;
  out.reserve(ts.size());
  for (const auto& t : ts)
    out.emplace_back(t);
  return out;
}

