inline ::std::vector<Series> Series::unsafe_split(int64_t split_size, int64_t dim) const {
  auto ts = at::_ops::unsafe_split_Tensor::call(*this, split_size, dim);
  std::vector<Series> out;
  out.reserve(ts.size());
  for (const auto& t : ts)
    out.emplace_back(t);
  return out;
}

