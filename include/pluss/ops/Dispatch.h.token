#pragma once

#include "pluss/Note.h"
#include <vector>
#include <internals/core/include/b10/utils/Macros.h>

namespace pluss {

  // --- Broadcasting Utility ---
  namespace {
  
  Text broadcast_to(const Text& src, const std::vector<size_t>& target_shape, size_t dim = 0) {
    if (dim == target_shape.size()) return src;
    if (src.is_leaf()) {
      Text out = src;
      for (size_t d = dim; d < target_shape.size(); ++d) {
        std::vector<Text> reps(target_shape[d], out);
        out = std::move(reps);
      }
      return out;
    }
    const auto& children = src.children();
    PLUSS_INSPECT(children.size() == 1 || children.size() == target_shape[dim],
      "broadcast_to: shape mismatch at dimension ", dim);
    std::vector<Text> out;
    if (children.size() == 1) {
      for (size_t i = 0; i < target_shape[dim]; ++i)
        out.push_back(broadcast_to(children[0], target_shape, dim + 1));
    } else {
      for (const auto& child : children)
        out.push_back(broadcast_to(child, target_shape, dim + 1));
    }
    return out;
  }
  
  std::vector<size_t> shape_of(const Text& t) {
    std::vector<size_t> shape;
    const Text* curr = &t;
    while (!curr->is_leaf()) {
      shape.push_back(curr->children().size());
      curr = &curr->children()[0];
    }
    return shape;
  }
  
  std::vector<size_t> promote_shape(const std::vector<size_t>& a, const std::vector<size_t>& b) {
    size_t n = std::max(a.size(), b.size());
    std::vector<size_t> out(n);
    for (size_t i = 0; i < n; ++i) {
      size_t ad = (i < n - a.size()) ? 1 : a[i - (n - a.size())];
      size_t bd = (i < n - b.size()) ? 1 : b[i - (n - b.size())];
      PLUSS_INSPECT(ad == bd || ad == 1 || bd == 1,
        "broadcast: dimension mismatch (", ad, " vs ", bd, ") at dim ", i);
      out[i] = std::max(ad, bd);
    }
    return out;
  }
  
  std::pair<Text, Text> broadcast_pair(const Text& a, const Text& b) {
    auto sa = shape_of(a);
    auto sb = shape_of(b);
    auto out_shape = promote_shape(sa, sb);
    return {broadcast_to(a, out_shape), broadcast_to(b, out_shape)};
  }
  
  std::tuple<Text, Text, Text> broadcast_triple(const Text& a, const Text& b, const Text& c) {
    auto sa = shape_of(a);
    auto sb = shape_of(b);
    auto sc = shape_of(c);
    auto ab = promote_shape(sa, sb);
    auto abc = promote_shape(ab, sc);
    return {
      broadcast_to(a, abc),
      broadcast_to(b, abc),
      broadcast_to(c, abc)
    };
  }
  
  } // anonymous namespace
  
  // === Unary Dispatch ===
  inline Note dispatch_unary(const Note& input, const std::function<Chord(const Chord&)>& fn) {
    std::function<Text(const Text&)> apply = [&](const Text& t) -> Text {
      if (t.is_leaf()) return fn(t.leaf());
      std::vector<Text> out;
      out.reserve(t.children().size());
      for (const auto& sub : t.children()) out.push_back(apply(sub));
      return out;
    };
    return Note::wrap_note_impl(intrusive_ptr<detail::NoteBook>::make(apply(input.tree())), internal::NoteAccessToken::create());
  }
  
  // === Binary Dispatch ===
  inline Note dispatch_binary(const Note& a, const Note& b, const std::function<Chord(const Chord&, const Chord&)>& fn) {
    auto [ta, tb] = broadcast_pair(a.tree(), b.tree());
    std::function<Text(const Text&, const Text&)> apply = [&](const Text& ta, const Text& tb) -> Text {
      if (ta.is_leaf()) return fn(ta.leaf(), tb.leaf());
      const auto& ca = ta.children();
      const auto& cb = tb.children();
      std::vector<Text> out;
      out.reserve(ca.size());
      for (size_t i = 0; i < ca.size(); ++i)
        out.push_back(apply(ca[i], cb[i]));
      return out;
    };
    return Note::wrap_note_impl(intrusive_ptr<detail::NoteBook>::make(apply(ta, tb)), internal::NoteAccessToken::create());
  }
  
  // === Ternary Dispatch ===
  inline Note dispatch_ternary(const Note& a, const Note& b, const Note& c,
                               const std::function<Chord(const Chord&, const Chord&, const Chord&)>& fn) {
    auto [ta, tb, tc] = broadcast_triple(a.tree(), b.tree(), c.tree());
    std::function<Text(const Text&, const Text&, const Text&)> apply = [&](const Text& ta, const Text& tb, const Text& tc) -> Text {
      if (ta.is_leaf()) return fn(ta.leaf(), tb.leaf(), tc.leaf());
      const auto& ca = ta.children();
      const auto& cb = tb.children();
      const auto& cc = tc.children();
      std::vector<Text> out;
      out.reserve(ca.size());
      for (size_t i = 0; i < ca.size(); ++i)
        out.push_back(apply(ca[i], cb[i], cc[i]));
      return out;
    };
    return Note::wrap_note_impl(intrusive_ptr<detail::NoteBook>::make(apply(ta, tb, tc)), internal::NoteAccessToken::create());
  }
  
  // === Predicate Dispatch ===
  inline std::vector<bool> dispatch_predicate(const Note& input, const std::function<bool(const Chord&)>& fn) {
    std::vector<bool> out;
    std::function<void(const Text&)> collect = [&](const Text& t) {
      if (t.is_leaf()) {
        out.push_back(fn(t.leaf()));
      } else {
        for (const auto& child : t.children())
          collect(child);
      }
    };
    collect(input.tree());
    return out;
  }
  
  // === Binary Predicate ===
  inline std::vector<bool> dispatch_predicate_binary(const Note& a, const Note& b, const std::function<bool(const Chord&, const Chord&)>& fn) {
    auto [ta, tb] = broadcast_pair(a.tree(), b.tree());
    std::vector<bool> out;
    std::function<void(const Text&, const Text&)> collect = [&](const Text& ta, const Text& tb) {
      if (ta.is_leaf()) {
        out.push_back(fn(ta.leaf(), tb.leaf()));
      } else {
        const auto& ca = ta.children();
        const auto& cb = tb.children();
        for (size_t i = 0; i < ca.size(); ++i)
          collect(ca[i], cb[i]);
      }
    };
    collect(ta, tb);
    return out;
  }
  
  // === Where Dispatch ===
  inline Note dispatch_where(const Note& cond, const Note& x, const Note& y) {
    auto [tc, tx, ty] = broadcast_triple(cond.tree(), x.tree(), y.tree());
    std::function<Text(const Text&, const Text&, const Text&)> apply = [&](const Text& c, const Text& x, const Text& y) -> Text {
      if (c.is_leaf()) {
        // Check for "1" or "true" as true conditions
        const std::string& val = c.leaf().str();
        return (val == "1" || val == "true") ? x : y;
      }
      const auto& cc = c.children();
      const auto& cx = x.children();
      const auto& cy = y.children();
      std::vector<Text> out;
      out.reserve(cc.size());
      for (size_t i = 0; i < cc.size(); ++i)
        out.push_back(apply(cc[i], cx[i], cy[i]));
      return out;
    };
    return Note::wrap_note_impl(intrusive_ptr<detail::NoteBook>::make(apply(tc, tx, ty)), internal::NoteAccessToken::create());
  }
  
  inline Note dispatch_comparator(const Note& a, const Note& b,
    const std::function<bool(const Chord&, const Chord&)>& fn) {
    auto [ta, tb] = broadcast_pair(a.tree(), b.tree());

    std::function<Text(const Text&, const Text&)> apply = [&](const Text& ta, const Text& tb) -> Text {
      if (ta.is_leaf()) return fn(ta.leaf(), tb.leaf()) ? Chord("true") : Chord("false");

      const auto& ca = ta.children(), cb = tb.children();
      std::vector<Text> out;
      out.reserve(ca.size());
      for (size_t i = 0; i < ca.size(); ++i)
        out.push_back(apply(ca[i], cb[i]));
      return out;
    };

    return Note::wrap_note_impl(intrusive_ptr<detail::NoteBook>::make(apply(ta, tb)), internal::NoteAccessToken::create());
}

// === Stack ===
inline Note dispatch_stack(const std::vector<Note>& notes, int dim) {
  PLUSS_VALIDATE(!notes.empty(), "stack: input list cannot be empty");

  // Validate same shape
  const auto& shape0 = notes[0].shape();
  for (const auto& note : notes)
    PLUSS_VALIDATE(note.shape() == shape0, "stack: all Notes must have the same shape");

  std::function<Text(std::vector<Text>, int)> insert_dim;
  insert_dim = [&](std::vector<Text> nodes, int d) -> Text {
    if (d == 0) return nodes;
    size_t len = nodes[0].children().size();
    std::vector<Text> grouped;
    grouped.reserve(len);
    for (size_t i = 0; i < len; ++i) {
      std::vector<Text> ith;
      ith.reserve(nodes.size());
      for (const auto& t : nodes)
        ith.push_back(t.children()[i]);
      grouped.push_back(insert_dim(std::move(ith), d - 1));
    }
    return grouped;
  };

  std::vector<Text> trees;
  trees.reserve(notes.size());
  for (const auto& n : notes) trees.push_back(n.tree());

  return Note::wrap_note_impl(
    intrusive_ptr<detail::NoteBook>::make(insert_dim(std::move(trees), dim)), internal::NoteAccessToken::create());
}

// === Map ===
inline Note dispatch_map(const Note& input, const std::function<Chord(const Chord&)>& fn) {
  return dispatch_unary(input, fn);
}

// === Squeeze ===
inline Note dispatch_squeeze(const Note& input, int dim = -1) {
  std::function<Text(const Text&, int, int)> squeeze_at = [&](const Text& t, int target, int curr_dim) -> Text {
    if (t.is_leaf()) return t;
    const auto& children = t.children();
    if ((dim == -1 || curr_dim == dim) && children.size() == 1)
      return squeeze_at(children[0], target, curr_dim + 1);
    std::vector<Text> out;
    for (const auto& c : children)
      out.push_back(squeeze_at(c, target, curr_dim + 1));
    return out;
  };
  return Note::wrap_note_impl(intrusive_ptr<detail::NoteBook>::make(squeeze_at(input.tree(), dim, 0)), internal::NoteAccessToken::create());
}

// === Unsqueeze ===
inline Note dispatch_unsqueeze(const Note& input, int dim) {
  std::function<Text(const Text&, int, int)> insert_at = [&](const Text& t, int target, int curr_dim) -> Text {
    if (curr_dim == target) return Text{std::vector<Text>{t}};
    if (t.is_leaf()) return t;
    std::vector<Text> out;
    for (const auto& c : t.children())
      out.push_back(insert_at(c, target, curr_dim + 1));
    return out;
  };
  return Note::wrap_note_impl(intrusive_ptr<detail::NoteBook>::make(insert_at(input.tree(), dim, 0)), internal::NoteAccessToken::create());
}

// === Slice ===
inline Note dispatch_slice(const Note& input, int dim, int start, int end) {
  std::function<Text(const Text&, int, int)> slice = [&](const Text& t, int d, int curr) -> Text {
    PLUSS_VALIDATE(!t.is_leaf(), "Cannot slice a scalar Note");

    const auto& children = t.children();
    PLUSS_INSPECT(start >= 0 && end <= static_cast<int>(children.size()) && start <= end,"Invalid slice range: start=", start, ", end=", end);

    if (curr == d) {
      std::vector<Text> out(children.begin() + start, children.begin() + end);
      return Text(std::move(out));
    }

    std::vector<Text> out;
    out.reserve(children.size());
    for (const auto& child : children)
      out.push_back(slice(child, d, curr + 1));
    return Text(std::move(out));
  };

  return Note::wrap_note_impl(
      intrusive_ptr<detail::NoteBook>::make(slice(input.tree(), dim, 0)), internal::NoteAccessToken::create());
}

// === Repeat ===
inline Note dispatch_repeat(const Note& input, const std::vector<int64_t>& repeats) {
  std::function<Text(const Text&, size_t)> apply;
  apply = [&](const Text& t, size_t dim) -> Text {
    if (dim == repeats.size()) {
      return t;  // No more repetition
    }

    const int rep = repeats[dim];
    PLUSS_VALIDATE(rep >= 0, "repeat: all repeat counts must be non-negative");

    if (t.is_leaf()) {
      std::vector<Text> out(rep, t);
      return out;
    }

    const auto& children = t.children();
    std::vector<Text> out;
    out.reserve(children.size() * rep);

    for (const auto& child : children) {
      Text repeated = apply(child, dim + 1);
      for (int i = 0; i < rep; ++i)
        out.push_back(repeated);
    }

    return out;
  };

  return Note::wrap_note_impl(
      intrusive_ptr<detail::NoteBook>::make(apply(input.tree(), 0)), internal::NoteAccessToken::create());
}
} //namespace pluss
