#pragma once

#include <memory>
#include <string>
#include <vector>
#include <unordered_map>
#include <functional>
#include <pluss/datalog/handle/feed/feed.h>

namespace pluss::handle {

/**
 * @brief Catalog - 2D document collection (analogous to DataFrame in table module)
 * 
 * Feed-First Design Philosophy:
 * - Feed (1D): Document field operations
 * - Catalog (2D): Collection of documents (MongoDB collection)
 * - Archive (3D): Database of collections
 * 
 * A Catalog is a collection of documents (like MongoDB collection).
 * Each document is represented as a collection of Feeds.
 * 
 * MongoDB-inspired operations:
 * - CRUD: insert(), find(), update(), delete()
 * - Aggregation: aggregate(), group(), match(), project()
 * - Indexing: create_index(), drop_index()
 * - Querying: find_one(), find_many(), count()
 */
class Catalog {
public:
    using Document = std::unordered_map<std::string, Feed>;
    using Query = std::function<bool(const Document&)>;
    using Update = std::function<Document(const Document&)>;
    using Projection = std::vector<std::string>;
    
    Catalog();
    explicit Catalog(const std::string& name);
    Catalog(const Catalog&);
    Catalog& operator=(const Catalog&);
    Catalog(Catalog&&) noexcept;
    Catalog& operator=(Catalog&&) noexcept;
    ~Catalog();

    // Accessors
    [[nodiscard]] const std::string& name() const noexcept;
    void set_name(const std::string& n);
    [[nodiscard]] int64_t size() const;
    [[nodiscard]] bool empty() const;

    // ========== CRUD OPERATIONS (Feed-First Design) ==========
    
    // Insert operations
    [[nodiscard]] std::shared_ptr<Catalog> insert_one(const Document& doc) const;
    [[nodiscard]] std::shared_ptr<Catalog> insert_many(const std::vector<Document>& docs) const;
    
    // Find operations
    [[nodiscard]] std::vector<Document> find(const Query& query) const;
    [[nodiscard]] std::vector<Document> find(const Query& query, const Projection& projection) const;
    [[nodiscard]] Document find_one(const Query& query) const;
    [[nodiscard]] std::vector<Document> find_all() const;
    [[nodiscard]] int64_t count(const Query& query) const;
    [[nodiscard]] bool exists(const Query& query) const;
    
    // Update operations
    [[nodiscard]] std::shared_ptr<Catalog> update_one(const Query& query, const Update& update) const;
    [[nodiscard]] std::shared_ptr<Catalog> update_many(const Query& query, const Update& update) const;
    [[nodiscard]] std::shared_ptr<Catalog> replace_one(const Query& query, const Document& replacement) const;
    
    // Delete operations
    [[nodiscard]] std::shared_ptr<Catalog> delete_one(const Query& query) const;
    [[nodiscard]] std::shared_ptr<Catalog> delete_many(const Query& query) const;
    
    // ========== AGGREGATION OPERATIONS ==========
    
    // Aggregation pipeline
    class Pipeline;
    [[nodiscard]] std::shared_ptr<Pipeline> aggregate() const;
    
    // Common aggregations (Feed-first: delegate to Feed operations)
    [[nodiscard]] std::shared_ptr<Catalog> group(const std::string& by_field) const;
    [[nodiscard]] std::shared_ptr<Catalog> match(const Query& query) const;
    [[nodiscard]] std::shared_ptr<Catalog> project(const Projection& fields) const;
    [[nodiscard]] std::shared_ptr<Catalog> sort(const std::string& field, bool ascending = true) const;
    [[nodiscard]] std::shared_ptr<Catalog> limit(int64_t n) const;
    [[nodiscard]] std::shared_ptr<Catalog> skip(int64_t n) const;
    
    // Statistical aggregations on fields
    [[nodiscard]] double sum(const std::string& field) const;
    [[nodiscard]] double avg(const std::string& field) const;
    [[nodiscard]] double min(const std::string& field) const;
    [[nodiscard]] double max(const std::string& field) const;
    [[nodiscard]] int64_t count_field(const std::string& field) const;
    
    // ========== INDEXING OPERATIONS ==========
    
    void create_index(const std::string& field, bool unique = false);
    void drop_index(const std::string& field);
    [[nodiscard]] std::vector<std::string> list_indexes() const;
    
    // ========== QUERY HELPERS (MongoDB-style) ==========
    
    // Build queries using MongoDB operators
    static Query eq(const std::string& field, const Feed::ScalarValue& value);
    static Query ne(const std::string& field, const Feed::ScalarValue& value);
    static Query lt(const std::string& field, const Feed::ScalarValue& value);
    static Query lte(const std::string& field, const Feed::ScalarValue& value);
    static Query gt(const std::string& field, const Feed::ScalarValue& value);
    static Query gte(const std::string& field, const Feed::ScalarValue& value);
    static Query in(const std::string& field, const std::vector<Feed::ScalarValue>& values);
    static Query nin(const std::string& field, const std::vector<Feed::ScalarValue>& values);
    static Query exists(const std::string& field, bool should_exist = true);
    static Query type(const std::string& field, const std::string& type_name);
    static Query regex(const std::string& field, const std::string& pattern);
    
    // Logical operators
    static Query and_(const std::vector<Query>& queries);
    static Query or_(const std::vector<Query>& queries);
    static Query not_(const Query& query);
    static Query nor(const std::vector<Query>& queries);
    
    // ========== UPDATE HELPERS (MongoDB-style) ==========
    
    // Build updates using MongoDB operators
    static Update set(const std::string& field, const Feed& value);
    static Update unset(const std::string& field);
    static Update inc(const std::string& field, double amount);
    static Update mul(const std::string& field, double factor);
    static Update rename(const std::string& old_name, const std::string& new_name);
    static Update set_on_insert(const std::string& field, const Feed& value);
    static Update current_date(const std::string& field);
    
    // Array update operators
    static Update push(const std::string& field, const Feed::ScalarValue& value);
    static Update push_each(const std::string& field, const std::vector<Feed::ScalarValue>& values);
    static Update pull(const std::string& field, const Feed::ScalarValue& value);
    static Update pop(const std::string& field, int direction = 1);
    static Update add_to_set(const std::string& field, const Feed::ScalarValue& value);
    
    // ========== I/O OPERATIONS ==========
    
    [[nodiscard]] std::string to_json() const;
    [[nodiscard]] std::string to_bson() const;
    static std::shared_ptr<Catalog> from_json(const std::string& json, const std::string& name = "");
    static std::shared_ptr<Catalog> from_bson(const std::string& bson, const std::string& name = "");
    
    // Display operations
    void display(int64_t n = 10) const;
    void info() const;
    [[nodiscard]] std::string to_string() const;

private:
    struct Impl;
    std::unique_ptr<Impl> impl_;
};

/**
 * @brief Aggregation Pipeline for complex queries
 */
class Catalog::Pipeline {
public:
    explicit Pipeline(const Catalog* catalog);
    
    // Pipeline stages
    [[nodiscard]] Pipeline& match(const Query& query);
    [[nodiscard]] Pipeline& project(const Projection& fields);
    [[nodiscard]] Pipeline& group(const std::string& by_field);
    [[nodiscard]] Pipeline& sort(const std::string& field, bool ascending = true);
    [[nodiscard]] Pipeline& limit(int64_t n);
    [[nodiscard]] Pipeline& skip(int64_t n);
    [[nodiscard]] Pipeline& unwind(const std::string& array_field);
    [[nodiscard]] Pipeline& lookup(const std::string& from, const std::string& local_field,
                                     const std::string& foreign_field, const std::string& as);
    
    // Execute pipeline
    [[nodiscard]] std::shared_ptr<Catalog> execute() const;
    [[nodiscard]] std::vector<Document> to_documents() const;

private:
    struct PipelineImpl;
    std::unique_ptr<PipelineImpl> impl_;
};

}  // namespace pluss::handle

