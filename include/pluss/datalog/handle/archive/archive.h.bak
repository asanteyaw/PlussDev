#pragma once

#include <memory>
#include <string>
#include <vector>
#include <unordered_map>
#include <functional>
#include <pluss/datalog/handle/catalog/catalog.h>

namespace pluss::handle {

/**
 * @brief Archive - 3D database structure (analogous to Atlas in table module)
 * 
 * Feed-First Design Philosophy:
 * - Feed (1D): Document field operations
 * - Catalog (2D): Collection of documents (MongoDB collection)
 * - Archive (3D): Database of collections (MongoDB database)
 * 
 * An Archive is a database containing multiple Catalogs (collections).
 * All operations are vectorized across collections and delegate to Catalog operations.
 * 
 * MongoDB-inspired database operations:
 * - Collection management: create_collection(), drop_collection(), list_collections()
 * - Cross-collection queries: union(), intersect()
 * - Database-level aggregations
 * - Backup/restore operations
 */
class Archive {
public:
    Archive();
    explicit Archive(const std::string& name);
    Archive(const Archive&);
    Archive& operator=(const Archive&);
    Archive(Archive&&) noexcept;
    Archive& operator=(Archive&&) noexcept;
    ~Archive();

    // Accessors
    [[nodiscard]] const std::string& name() const noexcept;
    void set_name(const std::string& n);
    [[nodiscard]] int64_t num_collections() const;
    [[nodiscard]] bool empty() const;

    // ========== COLLECTION MANAGEMENT (Feed-First Design) ==========
    
    // Create and drop collections
    [[nodiscard]] std::shared_ptr<Archive> create_collection(const std::string& collection_name) const;
    [[nodiscard]] std::shared_ptr<Archive> drop_collection(const std::string& collection_name) const;
    [[nodiscard]] std::shared_ptr<Archive> rename_collection(const std::string& old_name, const std::string& new_name) const;
    
    // Access collections
    [[nodiscard]] std::shared_ptr<Catalog> get_collection(const std::string& name) const;
    [[nodiscard]] std::shared_ptr<Archive> set_collection(const std::string& name, const std::shared_ptr<Catalog>& catalog) const;
    [[nodiscard]] std::vector<std::string> list_collections() const;
    [[nodiscard]] bool has_collection(const std::string& name) const;
    
    // ========== CROSS-COLLECTION OPERATIONS ==========
    
    // Combine multiple collections
    [[nodiscard]] std::shared_ptr<Catalog> union_collections(const std::vector<std::string>& collection_names) const;
    [[nodiscard]] std::shared_ptr<Catalog> intersect_collections(const std::vector<std::string>& collection_names,
                                                                   const std::string& on_field) const;
    [[nodiscard]] std::shared_ptr<Archive> merge_archives(const std::shared_ptr<Archive>& other) const;
    
    // Aggregate across collections
    [[nodiscard]] double sum_across(const std::string& field) const;
    [[nodiscard]] double avg_across(const std::string& field) const;
    [[nodiscard]] int64_t count_across() const;
    [[nodiscard]] int64_t count_documents(const std::string& collection_name) const;
    
    // ========== DATABASE-LEVEL OPERATIONS ==========
    
    // Statistics
    [[nodiscard]] std::unordered_map<std::string, int64_t> collection_sizes() const;
    [[nodiscard]] int64_t total_documents() const;
    [[nodiscard]] double total_size_mb() const;
    
    // Indexing across collections
    void create_index_all(const std::string& field, bool unique = false);
    void drop_index_all(const std::string& field);
    
    // Apply operation to all collections (Feed-first: delegate to Catalog operations)
    [[nodiscard]] std::shared_ptr<Archive> map_collections(
        std::function<std::shared_ptr<Catalog>(const std::shared_ptr<Catalog>&)> func) const;
    [[nodiscard]] std::shared_ptr<Archive> filter_collections(
        std::function<bool(const std::shared_ptr<Catalog>&)> predicate) const;
    
    // ========== QUERY OPERATIONS ==========
    
    // Search across all collections
    [[nodiscard]] std::vector<std::pair<std::string, std::vector<Catalog::Document>>> 
        find_in_all(const Catalog::Query& query) const;
    [[nodiscard]] std::unordered_map<std::string, int64_t> count_in_all(const Catalog::Query& query) const;
    
    // ========== BACKUP/RESTORE ==========
    
    // Export/import entire database
    [[nodiscard]] std::string export_to_json() const;
    [[nodiscard]] std::string export_to_bson() const;
    static std::shared_ptr<Archive> import_from_json(const std::string& json, const std::string& name = "");
    static std::shared_ptr<Archive> import_from_bson(const std::string& bson, const std::string& name = "");
    
    // Save/load from files
    void save_to_file(const std::string& filepath, const std::string& format = "json") const;
    static std::shared_ptr<Archive> load_from_file(const std::string& filepath, const std::string& format = "json");
    
    // ========== I/O OPERATIONS ==========
    
    void display() const;
    void info() const;
    [[nodiscard]] std::string to_string() const;
    [[nodiscard]] std::string schema() const;  // Show structure of all collections
    
    // ========== TRANSACTION-LIKE OPERATIONS ==========
    
    // Batch operations across collections
    class Transaction;
    [[nodiscard]] std::shared_ptr<Transaction> begin_transaction();
    
    // Snapshot/restore
    [[nodiscard]] std::shared_ptr<Archive> snapshot() const;
    [[nodiscard]] std::shared_ptr<Archive> restore(const std::shared_ptr<Archive>& snapshot) const;
    
    // ========== MONGODB-STYLE DATABASE COMMANDS ==========
    
    // Database metadata
    [[nodiscard]] std::unordered_map<std::string, std::string> stats() const;
    void compact();  // Optimize storage
    void validate();  // Check integrity
    
    // Replication/sharding helpers (placeholders for future)
    void enable_sharding(const std::string& collection_name);
    void shard_collection(const std::string& collection_name, const std::string& shard_key);

private:
    struct Impl;
    std::unique_ptr<Impl> impl_;
};

/**
 * @brief Transaction for batch operations
 */
class Archive::Transaction {
public:
    explicit Transaction(Archive* archive);
    
    // Add operations to transaction
    Transaction& insert(const std::string& collection, const Catalog::Document& doc);
    Transaction& update(const std::string& collection, const Catalog::Query& query, const Catalog::Update& update);
    Transaction& delete_doc(const std::string& collection, const Catalog::Query& query);
    
    // Execute transaction
    [[nodiscard]] std::shared_ptr<Archive> commit();
    void rollback();
    
private:
    struct TransactionImpl;
    std::unique_ptr<TransactionImpl> impl_;
};

}  // namespace pluss::handle
