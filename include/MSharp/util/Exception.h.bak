#pragma once

// Minimal stub for exception/assert utilities expected from upstream
#include <stdexcept>

namespace MSharp {
struct Error : public std::runtime_error {
  using std::runtime_error::runtime_error;
};
} // namespace MSharp

// Minimal no-op assert macro used in device validation; these are debug-only
#ifndef TORCH_INTERNAL_ASSERT_DEBUG_ONLY
#define TORCH_INTERNAL_ASSERT_DEBUG_ONLY(cond, ...) ((void)0)
#endif

#ifndef TORCH_CHECK
#define TORCH_CHECK(cond, ...) \
  do { \
    if (!(cond)) { \
      throw MSharp::Error("TORCH_CHECK failed"); \
    } \
  } while (0)
#endif
