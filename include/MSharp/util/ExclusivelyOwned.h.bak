#pragma once

namespace MSharp {

// Primary template for ExclusivelyOwnedTraits. Some translation units
// provide explicit specializations (e.g., for Storage). Provide a
// default empty traits struct to allow specializations later.
template <typename T>
struct ExclusivelyOwnedTraits {};

} // namespace MSharp
#pragma once

namespace MSharp {

template <typename T>
struct MaybeOwnedTraits;

} // namespace MSharp
