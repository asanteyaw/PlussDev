#include <PlussQit/Functions.h>
#include <PlussQit/MapAllocator.h>
#include <PlussQit/StorageUtils.h>
#include <MSharp/core/TensorOptions.h>

namespace pluss {

C10_EXPORT MSharp::intrusive_ptr<MSharp::StorageImpl> new_shm_fd_storage(
    size_t size) {
  int flags = ALLOCATOR_MAPPED_SHAREDMEM | ALLOCATOR_MAPPED_EXCLUSIVE |
      ALLOCATOR_MAPPED_KEEPFD | ALLOCATOR_MAPPED_UNLINK;
  std::string handle = NewProcessWideShmHandle();
  auto sptr = MapAllocator::makeDataPtr(
      handle, flags, size * sizeof(uint8_t), nullptr);
  return MSharp::make_intrusive<StorageImpl>(
      MSharp::StorageImpl::use_byte_size_t(),
      size,
      std::move(sptr),
      /*allocator=*/nullptr,
      /*resizable=*/false);
}

C10_EXPORT void storage_copy(
    MSharp::Storage& dst,
    const MSharp::Storage& src,
    bool non_blocking) {
  auto dst_options = MSharp::TensorOptions().device(dst.device()).dtype(pluss::kByte);
  auto dst_t = pluss::empty({0}, dst_options).set_(dst);

  auto src_options = MSharp::TensorOptions().device(src.device()).dtype(pluss::kByte);
  auto src_t = pluss::empty({0}, src_options).set_(src);
  dst_t.copy_(src_t, non_blocking);
}

C10_EXPORT void share_memory_(TensorBase& t) {
  if (t.device() != pluss::kCPU) {
    return;
  }

  const pluss::Storage& origStorage = t.storage();

  if (MapAllocator::fromDataPtr(origStorage.data_ptr()) != nullptr) {
    // already shared
    return;
  }
  pluss::Storage newStorage(new_shm_fd_storage(origStorage.nbytes()));
  storage_copy(newStorage, origStorage);

  // Replace the old data_ptr and allocator with the new ones
  MSharp::StorageImpl* origStorageImpl = origStorage.unsafeGetStorageImpl();
  MSharp::StorageImpl* newStorageImpl = newStorage.unsafeGetStorageImpl();
  origStorageImpl->set_data_ptr(std::move(newStorageImpl->mutable_data_ptr()));
  origStorageImpl->set_allocator(newStorageImpl->allocator());
}

} // namespace pluss
