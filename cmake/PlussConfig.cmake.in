@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(_pluss_targets_file "${CMAKE_CURRENT_LIST_DIR}/PlussTargets.cmake")
set(_pluss_targets_content "")
if(EXISTS "${_pluss_targets_file}")
  file(READ "${_pluss_targets_file}" _pluss_targets_content)
endif()
set(_pluss_qit_targets_file "${CMAKE_CURRENT_LIST_DIR}/../PlussQit/PlussQitTargets.cmake")
set(_pluss_qit_targets_content "")
if(EXISTS "${_pluss_qit_targets_file}")
  file(READ "${_pluss_qit_targets_file}" _pluss_qit_targets_content)
endif()
set(_pluss_export_content "${_pluss_targets_content}\n${_pluss_qit_targets_content}")

string(FIND "${_pluss_export_content}" "Arrow::arrow" _pluss_needs_arrow)
string(FIND "${_pluss_export_content}" "Parquet::parquet" _pluss_needs_parquet)
string(FIND "${_pluss_export_content}" "CURL::libcurl" _pluss_needs_curl)
string(FIND "${_pluss_export_content}" "X11::X11" _pluss_needs_x11)
string(FIND "${_pluss_export_content}" "Freetype::Freetype" _pluss_needs_freetype)
string(FIND "${_pluss_export_content}" "fmt::fmt" _pluss_needs_fmt)
string(FIND "${_pluss_export_content}" "SQLite3::SQLite3" _pluss_needs_sqlite3)
string(FIND "${_pluss_export_content}" "Pluss::Unistring" _pluss_needs_unistring)
string(FIND "${_pluss_export_content}" "Pluss::Zip" _pluss_needs_zip)
string(FIND "${_pluss_export_content}" "Threads::Threads" _pluss_needs_threads)
string(FIND "${_pluss_export_content}" "torch_library" _pluss_needs_torch_library)
string(FIND "${_pluss_export_content}" "torch;" _pluss_needs_torch_target)

if(NOT _pluss_needs_arrow EQUAL -1)
  find_dependency(Arrow CONFIG QUIET)
  if(TARGET Arrow::arrow AND NOT TARGET Arrow::arrow_shared)
    add_library(Arrow::arrow_shared INTERFACE IMPORTED)
    set_target_properties(Arrow::arrow_shared PROPERTIES INTERFACE_LINK_LIBRARIES "Arrow::arrow")
  elseif(TARGET Arrow::arrow_shared AND NOT TARGET Arrow::arrow)
    add_library(Arrow::arrow INTERFACE IMPORTED)
    set_target_properties(Arrow::arrow PROPERTIES INTERFACE_LINK_LIBRARIES "Arrow::arrow_shared")
  endif()
endif()

if(NOT _pluss_needs_parquet EQUAL -1)
  find_dependency(Parquet CONFIG QUIET)
  if(TARGET Parquet::parquet AND NOT TARGET Parquet::parquet_shared)
    add_library(Parquet::parquet_shared INTERFACE IMPORTED)
    set_target_properties(Parquet::parquet_shared PROPERTIES INTERFACE_LINK_LIBRARIES "Parquet::parquet")
  elseif(TARGET Parquet::parquet_shared AND NOT TARGET Parquet::parquet)
    add_library(Parquet::parquet INTERFACE IMPORTED)
    set_target_properties(Parquet::parquet PROPERTIES INTERFACE_LINK_LIBRARIES "Parquet::parquet_shared")
  endif()
endif()

if(NOT _pluss_needs_curl EQUAL -1)
  find_dependency(CURL QUIET)
endif()

if(NOT _pluss_needs_x11 EQUAL -1)
  find_dependency(X11)
endif()

if(NOT _pluss_needs_freetype EQUAL -1)
  find_dependency(Freetype)
endif()

if(NOT _pluss_needs_fmt EQUAL -1)
  find_dependency(fmt CONFIG QUIET)
endif()

if(NOT _pluss_needs_sqlite3 EQUAL -1)
  find_dependency(SQLite3)
  if(NOT TARGET SQLite3::SQLite3 AND TARGET SQLite::SQLite3)
    add_library(SQLite3::SQLite3 ALIAS SQLite::SQLite3)
  endif()
endif()

if(NOT _pluss_needs_unistring EQUAL -1)
  find_library(_pluss_unistring_library NAMES unistring libunistring)
  if(NOT _pluss_unistring_library)
    set(${CMAKE_FIND_PACKAGE_NAME}_FOUND FALSE)
    set(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE
        "This PlussII build needs libunistring. Install the library for this platform and configure again.")
    return()
  endif()
  if(NOT TARGET Pluss::Unistring)
    add_library(Pluss::Unistring UNKNOWN IMPORTED)
    set_target_properties(Pluss::Unistring PROPERTIES IMPORTED_LOCATION "${_pluss_unistring_library}")
  endif()
endif()

if(NOT _pluss_needs_zip EQUAL -1)
  find_library(_pluss_zip_library NAMES zip libzip)
  if(NOT _pluss_zip_library)
    set(${CMAKE_FIND_PACKAGE_NAME}_FOUND FALSE)
    set(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE
        "This PlussII build needs libzip. Install the library for this platform and configure again.")
    return()
  endif()
  if(NOT TARGET Pluss::Zip)
    add_library(Pluss::Zip UNKNOWN IMPORTED)
    set_target_properties(Pluss::Zip PROPERTIES IMPORTED_LOCATION "${_pluss_zip_library}")
  endif()
endif()

if(NOT _pluss_needs_threads EQUAL -1)
  find_dependency(Threads)
endif()

if(NOT _pluss_needs_torch_library EQUAL -1 OR NOT _pluss_needs_torch_target EQUAL -1)
  find_dependency(Torch QUIET)
endif()

if(NOT _pluss_needs_arrow EQUAL -1 AND NOT TARGET Arrow::arrow AND NOT TARGET Arrow::arrow_shared)
  set(${CMAKE_FIND_PACKAGE_NAME}_FOUND FALSE)
  set(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE
      "PlussII C++ requires Arrow for PlussMic parquet support, but Arrow CMake targets were not found. "
      "Install Arrow/Parquet and add their prefix to CMAKE_PREFIX_PATH (for example your conda env).")
  return()
endif()

if(NOT _pluss_needs_parquet EQUAL -1 AND NOT TARGET Parquet::parquet AND NOT TARGET Parquet::parquet_shared)
  set(${CMAKE_FIND_PACKAGE_NAME}_FOUND FALSE)
  set(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE
      "PlussII C++ requires Parquet for PlussMic parquet support, but Parquet CMake targets were not found. "
      "Install Arrow/Parquet and add their prefix to CMAKE_PREFIX_PATH (for example your conda env).")
  return()
endif()

if(NOT _pluss_needs_curl EQUAL -1 AND NOT TARGET CURL::libcurl)
  set(${CMAKE_FIND_PACKAGE_NAME}_FOUND FALSE)
  set(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE
      "PlussII C++ requires libcurl for URL loading support, but CURL::libcurl was not found. "
      "Install libcurl (or build PlussII C++ with bundled curl enabled) and retry.")
  return()
endif()

if(NOT _pluss_needs_fmt EQUAL -1 AND NOT TARGET fmt::fmt)
  set(${CMAKE_FIND_PACKAGE_NAME}_FOUND FALSE)
  set(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE
      "PlussII C++ was built with fmt-enabled public headers, but fmt::fmt was not found. "
      "Install fmt and add its prefix to CMAKE_PREFIX_PATH, or rebuild the distribution with PLUSSQIT_USE_FMT=OFF.")
  return()
endif()

if(NOT _pluss_needs_sqlite3 EQUAL -1 AND NOT TARGET SQLite3::SQLite3)
  set(${CMAKE_FIND_PACKAGE_NAME}_FOUND FALSE)
  set(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE
      "PlussII C++ requires SQLite3 for DataFrame SQL / Nexus query support, but SQLite3::SQLite3 was not found. "
      "Install SQLite development files and add their prefix to CMAKE_PREFIX_PATH, or rebuild the distribution without SQL support.")
  return()
endif()

if((NOT _pluss_needs_torch_library EQUAL -1 OR NOT _pluss_needs_torch_target EQUAL -1)
   AND (NOT TARGET torch OR NOT TARGET torch_library))
  set(${CMAKE_FIND_PACKAGE_NAME}_FOUND FALSE)
  set(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE
      "PlussII C++ was built with LibTorch-enabled CodeM exports, but Torch CMake targets were not found. "
      "Install LibTorch (or use your torch Python environment) and add Torch_DIR/CMAKE_PREFIX_PATH, "
      "or rebuild the distribution with PLUSS_ENABLE_TORCH=OFF.")
  return()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/../PlussQit/PlussQitTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/PlussTargets.cmake")

if(NOT TARGET Pluss::SDK AND TARGET Pluss::pluss)
  add_library(Pluss::SDK INTERFACE IMPORTED)
  # Default C++ link surface for <pluss/pluss.h>: Qit + Mic + Pl.
  set(_pluss_sdk_link_libs "Pluss::pluss")
  if(TARGET Pluss::PlussMic)
    list(APPEND _pluss_sdk_link_libs "Pluss::PlussMic")
  endif()
  if(TARGET Pluss::PlussPl)
    list(APPEND _pluss_sdk_link_libs "Pluss::PlussPl")
  endif()
  set_target_properties(Pluss::SDK PROPERTIES
    INTERFACE_LINK_LIBRARIES "${_pluss_sdk_link_libs}"
  )
endif()

# Public full-stack target. Retain Pluss::SDK for existing consumers.
if(NOT TARGET Pluss::PlussII AND TARGET Pluss::SDK)
  add_library(Pluss::PlussII INTERFACE IMPORTED)
  set_target_properties(Pluss::PlussII PROPERTIES
    INTERFACE_LINK_LIBRARIES "Pluss::SDK"
  )
endif()

check_required_components(Pluss)
